{
	"name": "playwright_js_pom",
	"version": "1.0.0",
	"description": "This project uses Playwright and the Page Object Model (POM) framework to perform end-to-end testing on web applications.",
	"main": "index.mjs",
	"type": "module",
	"scripts": {
		"ui-mode": "cross-env ENV=qa npx playwright test --ui",
		"test": "npx cross-env ENV=qa npx playwright test",
		"smoke": "npx cross-env ENV=qa npx playwright test --grep @smoke --retries=0",
		"refresh-gmail-token": "node TSAP/Data/Resources/refresh-gmail-token.js",
		"set-aws-bucket-from-environment": "node TSAP/Scripts/set-aws-bucket-from-environment.js",
		"create-attempt-folder": "node TSAP/Scripts/generate-report-shard-folder.js",
		"clone-active-report": "node TSAP/Scripts/clone-active-report.js",
		"set-next-attempt-folder-name-in-env": "node TSAP/Scripts/set-next-report-shard-folder.js",
		"set-next-report-folder-as-active-report-folder": "node TSAP/Scripts/set-next-report-folder-as-active-report-folder.js",
		"update-build-id-with-jenkins-build-number": "node TSAP/Scripts/update-build-id.js",
		"upload-report": "node --max-old-space-size=2048 TSAP/Scripts/main-pipeline-upload-report.js",
		"fetch-latest-attempt-folder": "node TSAP/Scripts/fetch-latest-report-shard-folder.js",
		"pull-last-failed-report-from-shard": "node --max-old-space-size=2048 TSAP/Scripts/rerun-pipeline-pull-last-failed-final-report-and-shard.js",
		"run-regression-upload-report": "cross-env ENV=qa node --max-old-space-size=2048 --optimize-for-size --expose-gc ./node_modules/.bin/playwright test --grep @Regression --timeout=2900000; node --max-old-space-size=2048 TSAP/Scripts/main-pipeline-upload-report.js",
		"club-and-host-generated-report": "node TSAP/Scripts/clone-active-report.js ; node --max-old-space-size=2048 TSAP/Scripts/main-pipeline-club-generated-report.js",
		"rerun-last-failed-test": "cross-env ENV=qa TOTAL_SHARDS=undefined CURRENT_SHARD=undefined node --max-old-space-size=4096 --optimize-for-size --expose-gc ./node_modules/.bin/playwright test --last-failed --timeout=2800000",
		"productionSanity": "npx cross-env ENV=qa npx playwright test --grep @productionSanity",
		"update-tags-from-env": "node TSAP/Scripts/updating-tag-command-from-env.js",
		"tags": "cross-env ENV=qa node --max-old-space-size=2048 --optimize-for-size --expose-gc ./node_modules/.bin/playwright test --grep \"deleteSurveys\\b\" --timeout=1800000",
		"report": "npx playwright show-report",
		"allure:open": "allure open allure-report",
		"allure_report": "npx allure generate my-allure-results --clean -o allure-report",
		"serve_allure_report": "npx allure open allure-report",
		"gather-report": "node gather-report.js",
		"biome_check": "npx @biomejs/biome check --write",
		"biome_format_check": "npx @biomejs/biome format --write",
		"delete_surveys": "npx cross-env ENV=qa WORKERS=2 npx playwright test --grep @deleteSurveys",
		"biome_lint_check": "npx @biomejs/biome lint --write"
	},
	"keywords": [],
	"author": "Arun Dev C",
	"license": "ISC",
	"homepage": "",
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@playwright/test": "1.59.1",
		"@types/node": "^20.11.30",
		"allure-playwright": "^2.1.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.864.0",
		"@cliqz/adblocker-playwright": "^1.26.2",
		"@deploysentinel/playwright-watch": "^0.2.2",
		"@faker-js/faker": "^10.1.0",
		"@google-cloud/language": "^6.5.0",
		"adm-zip": "^0.5.10",
		"canvas": "^3.1.0",
		"cheerio": "^1.0.0-rc.12",
		"cross-env": "^7.0.3",
		"cross-fetch": "^3.1.5",
		"date-fns": "^3.6.0",
		"dotenv": "^16.0.3",
		"franc": "^6.2.0",
		"fs-extra": "^11.1.1",
		"google-translate-api": "^2.3.0",
		"googleapis": "^137.1.0",
		"iso-639-1": "^3.1.4",
		"jimp": "^1.6.0",
		"js-base64": "^3.7.7",
		"js-yaml": "^4.1.1",
		"jsdom": "^24.1.0",
		"jsqr": "^1.4.0",
		"langdetect": "^0.2.1",
		"papaparse": "^5.4.1",
		"pdfjs-dist": "^3.11.174",
		"playwright-framework": "git+ssh://git@bitbucket.org/surveysparrow/playwright_framework.git#Vishnu/thrive-changes-v2",
		"request": "^2.88.2",
		"resemblejs": "^4.1.0",
		"uuid": "^11.1.0",
		"winston": "^3.13.0",
		"officeparser": "^6.0.4",
		"xmldom": "^0.6.0"
	}
}
